# ---- 前端本地依赖（仅本地浏览器测试用，无 package.json）----
/node_modules/
web/node_modules/

# ---- 构建产物与备份 ----
/tvbox-manager
/tvbox-manager.exe
/tvbox-manager.exe~
/bin/
/build/
/dist/
*.test
*.out

# ---- 运行时数据目录（整目录不入库）----
# config.json 含访问令牌；data.json 是本机的源、直播源与检测记录。
# 两者都由程序首次启动时自动创建（data 目录也会自动新建），克隆后无需手工准备。
/data/
/data-tmp/

# ---- 本地调试与临时数据 ----
.smoke-data/
.smoke.log
.smoke-sub.json
/.tmp/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Go 构建缓存（Windows Defender 拦 TEMP 时的替代目录）----
.gocache/
.gotmp/

# ---- WorkBuddy 工作区数据（项目记忆，仅本地）----
.workbuddy/
