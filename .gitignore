# ---- 前端本地依赖（仅本地浏览器测试用，无 package.json）----
/node_modules/
web/node_modules/

# ---- 构建产物与备份 ----
/tvbox-manager
/tvbox-manager.exe
/tvbox-manager.exe~
/bin/
*.test
*.out

# ---- 本地运行时配置（含访问令牌，不入库；克隆后首次启动自动生成）----
/data/config.json

# ---- 本地调试与临时数据 ----
.smoke-data/
.smoke.log
.smoke-sub.json

# ---- 运行时临时文件（data.json / config.json 本身要纳入版本管理）----
data/*.tmp
data/*.corrupt.*

# ---- 编辑器 / 系统 ----
.vscode/
*.swp
.DS_Store
Thumbs.db
